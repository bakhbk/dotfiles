# AI Agent runner
# Usage: aigent [-s "system prompt"] "task"
aigent() {
    local custom_system_prompt=""
    local task_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--system-prompt)
                if [ $# -lt 2 ]; then
                    echo "Error: $1 requires an argument"
                    return 1
                fi
                custom_system_prompt="$2"
                shift 2
                ;;
            *)
                task_args+=("$1")
                shift
                ;;
        esac
    done

    if [ ${#task_args[@]} -eq 0 ]; then
        echo "Usage: aigent [-s \"system prompt\"] \"task\""
        return 1
    fi

    unset LLM_BASE_URL LLM_API_KEY LLM_MODEL

    if [ -n "$custom_system_prompt" ]; then
        (cd ~/dotfiles/scripts && uv run ./aigent.py -s "$custom_system_prompt" "${task_args[@]}")
    else
        (cd ~/dotfiles/scripts && uv run ./aigent.py "${task_args[@]}")
    fi
}

# KR Jarvis AI Agent
# Usage: krbot [-s "system prompt"] "task"
krbot() {
    local custom_system_prompt=""
    local task_args=()

    # Parse flags: -s/--system-prompt takes one argument, everything else is task
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--system-prompt)
                if [ $# -lt 2 ]; then
                    echo "Error: $1 requires an argument"
                    return 1
                fi
                custom_system_prompt="$2"
                shift 2
                ;;
            *)
                task_args+=("$1")
                shift
                ;;
        esac
    done

    if [ ${#task_args[@]} -eq 0 ]; then
        echo "Usage: krbot [-s \"system prompt\"] \"task\""
        return 1
    fi

    local conf="$HOME/.config/dispatch/providers.conf"
    local script_dir="$HOME/dotfiles/scripts"
    if [ ! -f "$conf" ]; then
        echo "Error: $conf not found"
        return 1
    fi
    local url key model
    url=$(awk '/\[kr-jarvis\]/{f=1} f&&/^url=/{sub(/^url=/,""); print; exit}' "$conf")
    key=$(awk '/\[kr-jarvis\]/{f=1} f&&/^key=/{sub(/^key=/,""); print; exit}' "$conf")
    model=$(awk '/\[kr-jarvis\]/{f=1} f&&/^last_model=/{sub(/^last_model=/,""); sub(/\.gguf$/,"",$0); sub(/-Q[0-9]*_K.*/,""); print; exit}' "$conf")
    if [ -z "$url" ] || [ -z "$key" ]; then
        echo "Error: url/key not found in $conf"
        return 1
    fi
    export LLM_BASE_URL="$url" LLM_API_KEY="$key" LLM_MODEL="$model"

    if [ -n "$custom_system_prompt" ]; then
        (cd "$script_dir" && uv run ./aigent.py -s "$custom_system_prompt" "${task_args[@]}")
    else
        (cd "$script_dir" && uv run ./aigent.py "${task_args[@]}")
    fi
}


# Select a file via fzf (preview: first 75 lines, truncated to 250 chars), print its path,
# and copy its CONTENTS to the system clipboard (pbcopy/wl-copy/xclip).
# Usage: fs [-e] [dir-or-glob]   (default: ~/.agents/prompts)
#   -e  : open selected file in $EDITOR instead of copying to clipboard
fs() {
    local edit_mode=false
    local dir="$HOME/.agents/prompts"
    while getopts ":e" opt; do
        case $opt in
            e) edit_mode=true ;;
            *) echo "Usage: fs [-e] [dir-or-glob]"; return 1 ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -gt 0 ] && dir="$1"

    local qdir="${(q)dir}"
    # change:reload(...): every typed character triggers a content search via
    # grep over files in this directory (the official fzf 0.7x pattern).
    # ${(q)dir} -- shell-safe quoting; \\{} -- escape плейсхолдера fzf.
    # No -maxdepth: recursive find for nested directory structures.
    local _reloader="find $qdir -type f -exec grep -il -- \"\$FZF_QUERY\" \\{} + 2>/dev/null"
    f=$(find "$dir" -type f \
        | fzf --disabled \
               --bind "change:reload(${_reloader})" \
               --preview-window=wrap --preview 'head -75 {} | cut -c1-250') || return
    [ -z "$f" ] && return
    echo "$f"

    if $edit_mode; then
        local editor="${EDITOR:-nvim}"
        $editor "$f"
    else
        if   command -v pbcopy >/dev/null 2>&1; then pbcopy  < "$f"
        elif command -v wl-copy >/dev/null 2>&1; then wl-copy < "$f"
        elif command -v xclip >/dev/null 2>&1;   then xclip -selection clipboard < "$f"
        else echo "No clipboard tool found" >&2; return 1
        fi
        echo "✓ contents copied to clipboard"
    fi
}


netcheck() {
    local -a targets=("$@")
    [ ${#targets[@]} -eq 0 ] && targets=(8.8.8.8 1.1.1.1 yandex.ru baidu.com google.co.jp google.de)
    local timeout=2
    
    echo "🔍 Проверка сети"
    echo "======================="
    
    # Локальная сеть
    echo ""
    echo "📡 Локальная сеть:"
    
    # Локальный IP
    local my_ip
    if [[ "$OSTYPE" = darwin* ]]; then
        local _iface=$(route get default 2>/dev/null | awk '/interface:/ {print $2}')
        my_ip=$(ipconfig getifaddr "$_iface" 2>/dev/null || echo 'n/a')
    else
        my_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo 'n/a')
    fi
    echo "   🖥️  Твой IP: $my_ip"
    
    # Публичный IP
    local pub_ip="n/a"
    if [[ "$OSTYPE" = darwin* ]]; then
        pub_ip=$(curl -s --max-time 2 --fail https://ifconfig.me 2>/dev/null || curl -s --max-time 2 --fail https://icanhazip.com 2>/dev/null || echo 'n/a')
    else
        pub_ip=$(curl -s --max-time 2 --fail https://ifconfig.me 2>/dev/null || echo 'n/a')
    fi
    [ "$pub_ip" != "n/a" ] && echo "   🌐 Публичный IP: $pub_ip" || echo "   🌐 Публичный IP: не определяется"
    
    # HTTP проверка
    local http_ok=false
    echo ""
    echo "🌍 HTTP доступ:"
    for url in https://yandex.ru https://google.com; do
        _code=$(curl -s --max-time 3 -o /dev/null -w "%{http_code}" "$url" 2>/dev/null)
        case "$_code" in
            200|301|302)
                echo "   ✅ $url → $_code"
                http_ok=true
                ;;
            *)
                echo "   ❌ $url → ${_code:-timeout}"
                ;;
        esac
    done
    
    # Роутер/шлюз
    local gw
    if [[ "$OSTYPE" = darwin* ]]; then
        gw=$(route get default 2>/dev/null | awk '/gateway: / {print $2}')
    else
        gw=$(ip route 2>/dev/null | grep default | awk '{print $3}' | head -1)
    fi
    if [ -n "$gw" ] && [ "$gw" != "(default)" ]; then
        echo "   📶 Роутер: $gw"
        if timeout $timeout ping -c 1 "$gw" &>/dev/null; then
            echo "   ✅ Роутер доступен"
        else
            echo "   ❌ Роутер не отвечает — проверь Wi-Fi/кабель"
        fi
    else
        echo "   ❌ Шлюз не найден — нет подключения к сети"
    fi
    
    # Внешние хосты
    echo ""
    echo "🌐 DNS и Ping:"
    
    local count=0 passed=0 failed=0 dns_ok=false ping_ip=false dns_refused=false
    for t in "${targets[@]}"; do
        count=$((count + 1))
        echo "[$count/${#targets[@]}] $t..."
        
        if [[ "$t" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            if timeout $timeout ping -c 1 "$t" 2>&1 | grep -q "Destination.*Unreachable"; then
                echo "   ❌ Destination Unreachable — роутер не пушит наружу"
                failed=$((failed + 1))
            elif timeout $timeout ping -c 1 "$t" 2>&1 | grep -q "100% packet loss\|Request timeout"; then
                echo "   ❌ FAIL (${timeout}s)"
                failed=$((failed + 1))
            elif timeout $timeout ping -c 1 "$t" &>/dev/null; then
                echo "   ✅ OK"
                passed=$((passed + 1))
                ping_ip=true
            else
                echo "   ❌ FAIL (${timeout}s)"
                failed=$((failed + 1))
            fi
        else
            local ip=""
            if timeout $timeout nslookup "$t" 2>&1 | grep -q "REFUSED"; then
                dns_refused=true
                echo "   ❌ DNS REFUSED — роутер отказывает"
                failed=$((failed + 1))
            elif timeout $timeout nslookup "$t" 2>&1 | grep -q "server can't find\|NXDOMAIN"; then
                echo "   ❌ DNS FAIL (${timeout}s)"
                failed=$((failed + 1))
            elif timeout $timeout nslookup "$t" &>/dev/null; then
                ip=$(nslookup "$t" 2>/dev/null | grep "Address:" | tail -1 | awk '{print $2}')
                dns_ok=true
                if timeout $timeout ping -c 1 "$t" &>/dev/null; then
                    echo "   ✅ OK → $ip"
                    passed=$((passed + 1))
                else
                    echo "   ⚠️  TIMEOUT (${timeout}s)"
                    failed=$((failed + 1))
                fi
            else
                echo "   ❌ DNS FAIL (${timeout}s)"
                failed=$((failed + 1))
            fi
        fi
    done
    
    # Итог
    echo ""
    echo "======================="
    if [ $passed -eq $count ] && [ "$http_ok" = true ]; then
        echo "✅ интернет работает"
    elif [ $dns_refused = true ] && [ $http_ok = false ]; then
        echo "❌ Нет интернета — роутер не подключён к сети (проблема у провайдера)"
    elif [ $dns_ok = false ] && [ $ping_ip = true ]; then
        echo "⚠️  DNS не работает — проверь настройки DNS"
    elif [ $ping_ip = false ] && [ $dns_ok = true ]; then
        echo "⚠️  Нет доступа наружу — проверь фаервол/прокси"
    elif [ $failed -eq $count ]; then
        if [ -z "$gw" ] || [ "$gw" = "(default)" ]; then
            echo "❌ Нет сети — проверь Wi-Fi/кабель"
        else
            echo "❌ Нет интернета — проблема у провайдера"
        fi
    else
        echo "⚠️  Частичное подключение — некоторые серверы не доступны"
    fi
}


# Agent Runner Selector
# Usage: gar [-e|-d|-r "task"|-h]
#   -e, --edit      : open rendered SKILL.md in $EDITOR, then copy to clipboard
#   -d, --dry-run   : show rendered SKILL.md in terminal (no clipboard)
#   -r, --run "task": render + pass directly to pi with task
#   -h, --help      : show this help message
#   default         : render and copy to clipboard
# Find and run command on all matching files (e.g. frn pubspec.yaml "fcl;fpg")
frn() {
  local ROOT="${ROOT_DIR:-.}"
  [ -n "$1" ] && [ -n "$2" ] || {
    echo "❌ frn <file> <cmd>"
    echo "   ROOT_DIR=/path frn <file> \"<cmd1>;<cmd2>;...\""
    return 1
  }
  [ ! -d "$ROOT" ] && exit 1
  find "$ROOT" -name "$1" -type f | grep -vE '/(example|\.symlinks|build|\.dart_tool)/' \
    | sort | while read -r p; do
      local d
      d="$(dirname "$p")"
      echo "📦 $(cd "$d" && pwd)" && (cd "$d" && eval "$2" 2>&1) && echo "   ✅" || echo "   ❌"
    done; echo "✅ Done"
}

gar() {
    local config_file="$HOME/.config/agent-runner/config.json"
    local edit_mode=false
    local run_mode=false
    local dry_run_mode=false
    local help_mode=false
    local task=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -e|--edit)   edit_mode=true; shift ;;
            -d|--dry-run) dry_run_mode=true; shift ;;
            -r|--run)    run_mode=true; shift; task="$*"; break ;;
            -h|--help)   help_mode=true; shift ;;
            *)           shift ;;
        esac
    done

    # Show help if requested
    if $help_mode; then
        echo "Usage: gar [-e|-d|-r \"task\"]"
        echo ""
        echo "Options:"
        echo "  -e, --edit      Open rendered SKILL.md in \$EDITOR, then copy to clipboard"
        echo "  -d, --dry-run   Show rendered SKILL.md in terminal (no clipboard)"
        echo "  -r, --run \"task\" Render and pass directly to pi with task"
        echo "  -h, --help      Show this help message"
        echo ""
        echo 'Config: ~/.config/agent-runner/config.json'
        echo '  {'
        echo '    "agents": {'
        echo '      "<name>": {'
        echo '        "invocation": "...",'
        echo '        # optional:'
        echo '        "system_prompt_flag": "...",'
        echo '        "prompt_prefix": "..."'
        echo '      }'
        echo '    }'
        echo '  }'
        echo ''
        echo "Default: render and copy to clipboard"
        return 0
    fi

    # Check config exists
    if [ ! -f "$config_file" ]; then
        echo "❌ Config not found: $config_file" >&2
        return 1
    fi

    # Select agent via fzf with preview
    local agent
    agent=$(jq -r '.agents | keys[]' "$config_file" 2>/dev/null | \
            fzf --preview-window=wrap --preview "jq '.agents[\"{}\"]' $config_file" 2>/dev/null) || return

    [ -z "$agent" ] && return
    echo "✓ Selected agent: $agent"

    # Read config values
    local invocation system_prompt_flag prompt_prefix
    invocation=$(jq -r ".agents[\"$agent\"].invocation" "$config_file")
    system_prompt_flag=$(jq -r ".agents[\"$agent\"].system_prompt_flag // empty" "$config_file")
    prompt_prefix=$(jq -r ".agents[\"$agent\"].prompt_prefix" "$config_file")

    # Generate UUID once per invocation
    local uuid
    uuid=$(uuidgen | cut -c1-8)

    # Auto-create session directory
    mkdir -p "$HOME/.cache/agent-runner/$uuid"

    # Clean old prompt directories (>7 days)
    find "$HOME/.cache/agent-runner" -maxdepth 1 -type d -mtime +7 -exec rm -rf {} + 2>/dev/null

    # Render SKILL.md template using python3
    local rendered
    if [ -z "$system_prompt_flag" ]; then
        # No system prompt flag — remove System Prompt Control section
        rendered=$(python3 -c "
import re
template = open('$HOME/.agents/skills/agent-runner/SKILL.md').read()
template = re.sub(r'## System Prompt Control\n.*?(?=## Rules)', '', template, flags=re.DOTALL)
template = template.replace('{{AGENT_NAME}}', '$agent')
template = template.replace('{{INVOCATION}}', '''$invocation''')
template = template.replace('{{PROMPT_PREFIX}}', '$prompt_prefix')
template = template.replace('{{SESSION_UUID}}', '$uuid')
print(template, end='')
")
    else
        rendered=$(python3 -c "
template = open('$HOME/.agents/skills/agent-runner/SKILL.md').read()
template = template.replace('{{AGENT_NAME}}', '$agent')
template = template.replace('{{INVOCATION}}', '''$invocation''')
template = template.replace('{{SYSTEM_PROMPT_FLAG}}', '$system_prompt_flag')
template = template.replace('{{PROMPT_PREFIX}}', '$prompt_prefix')
template = template.replace('{{SESSION_UUID}}', '$uuid')
print(template, end='')
")
    fi

    if $run_mode; then
        # --run: create temp file and pass to pi
        local tmp_file
        tmp_file=$(mktemp /tmp/skill-XXXXXX.md)
        echo "$rendered" > "$tmp_file"
        echo "🚀 Running agent $agent with task: $task"
        pi --skill "$tmp_file" -p "$task"
        rm -f "$tmp_file"

    elif $edit_mode; then
        # --edit: open in editor, then copy to clipboard
        local tmp_file
        tmp_file=$(mktemp /tmp/skill-XXXXXX.md)
        echo "$rendered" > "$tmp_file"
        local editor="${EDITOR:-nvim}"
        $editor "$tmp_file"
        if command -v pbcopy >/dev/null 2>&1; then
            cat "$tmp_file" | pbcopy
        elif command -v wl-copy >/dev/null 2>&1; then
            cat "$tmp_file" | wl-copy
        else
            cat "$tmp_file" | xclip -selection clipboard
        fi
        rm -f "$tmp_file"
        echo "✓ Rendered SKILL.md for $agent copied to clipboard"

    elif $dry_run_mode; then
        # --dry-run: show in terminal
        echo "$rendered"

    else
        # default: copy to clipboard
        if command -v pbcopy >/dev/null 2>&1; then
            echo "$rendered" | pbcopy
        elif command -v wl-copy >/dev/null 2>&1; then
            echo "$rendered" | wl-copy
        else
            echo "$rendered" | xclip -selection clipboard
        fi
        echo "✓ Rendered SKILL.md for $agent copied to clipboard"
    fi
}
