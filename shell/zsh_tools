gitdo() {                                                                                            
    echo "in $(pwd)" >&2                                                                                
                                                                                                        
    # gitdo "..." | pbcopy  →  копирование через временный файл (надёжно)                               
    local COPY_FILE=""                                                                                  
    [[ -t 3 ]] && COPY_FILE=$(mktemp)                                                                   
    exec 3</dev/null                                                                                    
                                                                                                        
    find . -name .git -type d -prune | while read -r gitdir; do                                         
        repo_dir=$(dirname "$gitdir" | sed 's|^\./||')
        [ "$repo_dir" = "." ] && continue
                                                                                                        
        branch=$(git -C "$(dirname "$gitdir")" branch --show-current 2>/dev/null)                         
                                                                     
        if [ -n "$COPY_FILE" ]; then               
            out=$(cd "$(dirname "$gitdir")" && eval "$@" | sed $'s/\x1b\[[0-9;]*m//g')
        else                          
            out=$(cd "$(dirname "$gitdir")" && eval "$@") 
        fi
                                                      
        if [ -z "$out" ]; then                                                                            
        echo "· $repo_dir${branch:+ ($branch)} — без изменений\n\n" >&2                                 
        else                                                                                              
        echo "\033[2m┌─ $repo_dir${branch:+ ($branch)}\033[0m\n" >&2                                    
        if [ -n "$COPY_FILE" ]; then               
            out=$(cd "$(dirname "$gitdir")" && eval "$@" | sed $'s/\x1b\[[0-9;]*m//g')
            printf '%s\n' "$out" >> "$COPY_FILE"                                                          
        else                          
            out=$(cd "$(dirname "$gitdir")" && eval "$@") 
            printf '%s\n' "$out"                                                                          
        fi                                                                                              
        echo "\033[2m└──────────────────────────────\033[0m\n\n" >&2                                    
        fi                                                                                                
    done                                                                                                
    # копирование через файл — надёжно, без пайп-буферов                                                
    if [ -n "$COPY_FILE" ]; then                                                                        
        _clip_copy < "$COPY_FILE"; rm -f "$COPY_FILE"                                                         
        echo "✓ скопировано в буфер" >&2                                                                  
    fi                                                                                                  
}   

# AI Agent runner
# Usage: aigent [-s "system prompt"] "task"
aigent() {
    local custom_system_prompt=""
    local task_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--system-prompt)
                if [ $# -lt 2 ]; then
                    echo "Error: $1 requires an argument"
                    return 1
                fi
                custom_system_prompt="$2"
                shift 2
                ;;
            *)
                task_args+=("$1")
                shift
                ;;
        esac
    done

    if [ ${#task_args[@]} -eq 0 ]; then
        echo "Usage: aigent [-s \"system prompt\"] \"task\""
        return 1
    fi

    local conf="$HOME/.config/dispatch/providers.conf"
    if [ ! -f "$conf" ]; then
        echo "Error: $conf not found"
        return 1
    fi
    local url key model
    url=$(awk '/\[Gateway\]/{f=1} f&&/^url=/{sub(/^url=/,""); print; exit}' "$conf")
    key=$(awk '/\[Gateway\]/{f=1} f&&/^key=/{sub(/^key=/,""); print; exit}' "$conf")
    model=$(awk '/\[Gateway\]/{f=1} f&&/^last_model=/{sub(/^last_model=/,""); sub(/\.gguf$/,"",$0); sub(/-Q[0-9]*_K.*/,""); print; exit}' "$conf")
    if [ -z "$url" ] || [ -z "$key" ]; then
        echo "Error: url/key not found in $conf"
        return 1
    fi
    (export LLM_BASE_URL="$url" LLM_API_KEY="$key" LLM_MODEL="$model"
     cd ~/dotfiles/scripts || return 1
     if [ -n "$custom_system_prompt" ]; then
         uv run ./aigent.py -s "$custom_system_prompt" "${task_args[@]}"
     else
         uv run ./aigent.py "${task_args[@]}"
     fi)
}

