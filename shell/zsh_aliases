# Prep agents — sync models across all AI tools
# Где лежит репозиторий dotfiles (пишет installers/install_prep.sh)
if [[ -f ~/.dotfiles/dotfiles.env ]]; then
    source ~/.dotfiles/dotfiles.env
fi
: "${DOTFILES_DIR:=$HOME/dotfiles}"

prep() {
    local script="$DOTFILES_DIR/scripts/prep-agents/prep-agents.py"
    if [[ ! -f "$script" ]]; then
        echo "❌ prep: не найден $script (git pull + ./install.sh)" >&2
        return 1
    fi
    # NB: `command -v` can match an alias (oh-my-zsh sets uv='noglob uv'),
    # so check the real binary with `whence -p`.
    if whence -p uv &> /dev/null; then
        uv run "$script" "$@"
    elif command -v python3 &> /dev/null; then
        echo "⚠️  uv не найден — запускаю через python3 (установите: $DOTFILES_DIR/installers/install_uv.sh)" >&2
        python3 "$script" "$@"
    else
        echo "❌ prep: нужны uv или python3" >&2
        return 1
    fi
}
alias prep-fast='prep --max-context 8000'
alias prep-code='prep --max-context 16000'
alias prep-deep='prep --max-context 32000'
alias prep-big='prep --max-context 64000'
alias prep-clean='prep --cleanup'
