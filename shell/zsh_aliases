catt() {
    if [[ "$1" == *.md ]] && whence -p mdless >/dev/null 2>&1; then
        mdless "$@"
    elif whence -p bat >/dev/null 2>&1; then
        bat --theme=Nord --style=plain "$@"
    else
        cat "$@"
    fi
}

