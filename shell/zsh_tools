# Show project tree with gitignore-aware filtering
# Usage: t [dir] [depth] [tree flags...]   (defaults: . 2)
#   --all  : show gitignored files too
#   extra flags (e.g. -h, -C, -d) are passed through to tree
t() {
  local dir="${1:-.}"
  local depth="${2:-2}"
  local gitignore="--gitignore"
  local -a extra=()

  (( $# >= 2 )) && shift 2
  (( $# >= 1 )) && shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) gitignore=""; shift ;;
      *)     extra+=("$1"); shift ;;
    esac
  done

  tree "$dir" -L "$depth" $gitignore \
    -I "node_modules|dist|build|__pycache__|\.venv|\.next|\.cache|coverage|\.git|\.DS_Store|vendor|target|Pods|\.gradle" \
    -F "${extra[@]}"
}


# Select a file via fzf (preview: first 75 lines, truncated to 250 chars), print its path,
# and copy its CONTENTS to the system clipboard (pbcopy/wl-copy/xclip).
# Usage: fs [-e] [dir-or-glob]   (default: ~/.agents/prompts)
#   -e  : open selected file in $EDITOR instead of copying to clipboard
fs() {
    local edit_mode=false
    local dir="$HOME/.agents/prompts"
    while getopts ":e" opt; do
        case $opt in
            e) edit_mode=true ;;
            *) echo "Usage: fs [-e] [dir-or-glob]"; return 1 ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -gt 0 ] && dir="$1"

    local qdir="${(q)dir}"
    # change:reload(...): every typed character triggers a content search via
    # grep over files in this directory (the official fzf 0.7x pattern).
    # ${(q)dir} -- shell-safe quoting; \\{} -- escape плейсхолдера fzf.
    # No -maxdepth: recursive find for nested directory structures.
    local _reloader="{ find $qdir -type f -iname \"*\$FZF_QUERY*\"; find $qdir -type f -exec grep -il -- \"\$FZF_QUERY\" \\{} +; } 2>/dev/null | sort -u"
    f=$(find "$dir" -type f \
        | fzf --disabled \
               --bind "change:reload(${_reloader})" \
               --preview-window=wrap --preview 'head -75 {} | cut -c1-250') || return
    [ -z "$f" ] && return
    echo "$f"

    if $edit_mode; then
        local editor="${EDITOR:-nvim}"
        $editor "$f"
    else
        if _clip_copy < "$f"; then
            echo "✓ contents copied to clipboard"
        else
            echo "No clipboard tool found" >&2; return 1
        fi
        echo "✓ contents copied to clipboard"
    fi
}


_resolve() {
    local host=$1 srv=${2:-}
    if _has dig; then
        dig -t A "$host" ${srv:+@$srv} +short 2>/dev/null
    elif _has nslookup; then
        nslookup "$host" ${srv:-} 2>/dev/null | awk '/[Aa]ddress:/{print $NF}'
    else
        getent hosts "$host" 2>/dev/null | awk '{print $1}'
    fi
}

_ping() {
    local host=$1 to=${2:-2} out rc
    out=$(ping -c 1 -W "$to" "$host" 2>&1)
    rc=$?
    ((rc == 0)) && [[ $out != *'100% packet loss'* ]]
}

_net_probe() {
    local t=$1 to=$2 ip
    if [[ $t =~ '^[0-9.]+$' ]]; then
        _ping "$t" "$to" && echo "   ✅ $t OK" || echo "   ⚠️  $t — ICMP заблокирован"
    else
        ip=$(_resolve "$t" | head -1)
        [[ -z $ip ]] && { echo "   ❌ $t — DNS FAIL"; return; }
        _ping "$ip" "$to" && echo "   ✅ $t → $ip" || echo "   ⚠️  $t → $ip — ICMP заблокирован"
    fi
}

netcheck() {
    local -a targets=("$@")
    ((${#targets[@]})) || targets=(8.8.8.8 1.1.1.1 google.com yandex.ru)
    local to=2 gw ifc dns pub code url out ok=0 warn=0 fail=0 http_ok=false
    gw=$(_gateway)
    ifc=$(_iface)
    dns=$(_dns_servers)
    pub=$(curl -sL --max-time 3 ifconfig.me 2>/dev/null)
    [[ -z $pub ]] && pub=$(curl -sL --max-time 3 icanhazip.com 2>/dev/null)

    echo "🔍 Проверка сети"
    echo "======================="
    echo "📡 Локальная сеть:"
    echo "   🖥️  IP: $(_local_ip)  интерфейс: ${ifc:-?}"
    echo "   🌐 Публичный IP: ${pub:-не определяется}"
    echo "   📶 Шлюз: ${gw:-не найден}"
    echo "   🧪 DNS: ${dns:-не настроен}"

    echo ""
    echo "🌍 HTTP доступ:"
    for url in https://google.com https://yandex.ru; do
        code=$(curl -sL -o /dev/null --max-time 4 -w '%{http_code}' "$url")
        if [[ $code =~ '^[23]' ]]; then
            echo "   ✅ $url → $code"
            http_ok=true
        else
            echo "   ❌ $url → ${code:-timeout}"
        fi
    done

    echo ""
    echo "🌐 DNS и Ping:"
    for t in "${targets[@]}"; do
        out=$(_net_probe "$t" "$to")
        echo "$out"
        case $out in
            *✅*) ok=$((ok + 1)) ;;
            *⚠️*) warn=$((warn + 1)) ;;
            *) fail=$((fail + 1)) ;;
        esac
    done

    echo ""
    echo "======================="
    if [[ -z $gw ]]; then
        echo "❌ нет сети — шлюз не найден (Wi-Fi/кабель)"
    elif [[ $http_ok == true && $fail == 0 ]]; then
        echo "✅ интернет работает"
    elif [[ $http_ok == true ]]; then
        echo "✅ интернет работает, недоступно: ${fail} из ${#targets[@]}"
    elif ! _ping "$gw" "$to"; then
        echo "❌ роутер не отвечает — проверь подключение"
    elif [[ -z $(_resolve google.com) && -n $(_resolve google.com 8.8.8.8) ]]; then
        echo "⚠️  системный DNS (${dns:-none}) молчит, прямой резолвер работает"
        [[ $ifc =~ 'utun|tun' ]] && echo "   причина: VPN-туннель ($ifc) — переподключи или выключи VPN"
        if [[ $(uname -s) == Darwin ]]; then
            echo "   фикс: sudo networksetup -setdnsservers Wi-Fi 8.8.8.8 1.1.1.1"
        else
            echo "   фикс: sudo systemctl restart resolvconf  (или DNS в настройках VPN)"
        fi
    elif [[ $fail == 0 && $warn == ${#targets[@]} ]]; then
        echo "⚠️  DNS работает, ping к внешним хостам блокируется — проверь фаервол"
    elif _ping 8.8.8.8 "$to"; then
        echo "⚠️  частичное подключение — часть серверов недоступна"
    else
        echo "❌ нет доступа наружу — проблема на уровне роутера/провайдера"
    fi
}

# Agent Runner Selector
# Usage: gar [-e|-d|-r "task"|-h]
#   -e, --edit      : open rendered SKILL.md in $EDITOR, then copy to clipboard
#   -d, --dry-run   : show rendered SKILL.md in terminal (no clipboard)
#   -r, --run "task": render + pass directly to pi with task
#   -h, --help      : show this help message
#   default         : render and copy to clipboard
# Find and run command on all matching files (e.g. frn pubspec.yaml "fcl;fpg")
frn() {
  local ROOT="${ROOT_DIR:-.}"
  [ -n "$1" ] && [ -n "$2" ] || {
    echo "❌ frn <file> <cmd>"
    echo "   ROOT_DIR=/path frn <file> \"<cmd1>;<cmd2>;...\""
    return 1
  }
  [ ! -d "$ROOT" ] && exit 1
  find "$ROOT" -name "$1" -type f | grep -vE '/(example|\.symlinks|build|\.dart_tool)/' \
    | sort | while read -r p; do
      local d
      d="$(dirname "$p")"
      echo "📦 $(cd "$d" && pwd)" && (cd "$d" && eval "$2" 2>&1) && echo "   ✅" || echo "   ❌"
    done; echo "✅ Done"
}

gar() {
    local config_file="$HOME/.config/agent-runner/config.json"
    local edit_mode=false
    local run_mode=false
    local dry_run_mode=false
    local help_mode=false
    local task=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -e|--edit)   edit_mode=true; shift ;;
            -d|--dry-run) dry_run_mode=true; shift ;;
            -r|--run)    run_mode=true; shift; task="$*"; break ;;
            -h|--help)   help_mode=true; shift ;;
            *)           shift ;;
        esac
    done

    # Show help if requested
    if $help_mode; then
        echo "Usage: gar [-e|-d|-r \"task\"]"
        echo ""
        echo "Options:"
        echo "  -e, --edit      Open rendered SKILL.md in \$EDITOR, then copy to clipboard"
        echo "  -d, --dry-run   Show rendered SKILL.md in terminal (no clipboard)"
        echo "  -r, --run \"task\" Render and pass directly to pi with task"
        echo "  -h, --help      Show this help message"
        echo ""
        echo 'Config: ~/.config/agent-runner/config.json'
        echo '  {'
        echo '    "agents": {'
        echo '      "<name>": {'
        echo '        "invocation": "...",'
        echo '        # optional:'
        echo '        "system_prompt_flag": "...",'
        echo '        "prompt_prefix": "..."'
        echo '      }'
        echo '    }'
        echo '  }'
        echo ''
        echo "Default: render and copy to clipboard"
        return 0
    fi

    # Check config exists
    if [ ! -f "$config_file" ]; then
        echo "❌ Config not found: $config_file" >&2
        return 1
    fi

    # Select agent via fzf with preview
    local agent
    agent=$(jq -r '.agents | keys[]' "$config_file" 2>/dev/null | \
            fzf --preview-window=wrap --preview "jq '.agents[\"{}\"]' $config_file" 2>/dev/null) || return

    [ -z "$agent" ] && return
    echo "✓ Selected agent: $agent"

    # Read config values
    local invocation system_prompt_flag prompt_prefix
    invocation=$(jq -r ".agents[\"$agent\"].invocation" "$config_file")
    system_prompt_flag=$(jq -r ".agents[\"$agent\"].system_prompt_flag // empty" "$config_file")
    prompt_prefix=$(jq -r ".agents[\"$agent\"].prompt_prefix" "$config_file")

    # Generate UUID once per invocation
    local uuid
    uuid=$(uuidgen | cut -c1-8)

    # Auto-create session directory
    mkdir -p "$HOME/.cache/agent-runner/$uuid"

    # Clean old prompt directories (>7 days)
    find "$HOME/.cache/agent-runner" -maxdepth 1 -type d -mtime +7 -exec rm -rf {} + 2>/dev/null

    # Render SKILL.md template using python3
    local rendered
    if [ -z "$system_prompt_flag" ]; then
        # No system prompt flag — remove System Prompt Control section
        rendered=$(python3 -c "
import re
template = open('$HOME/.agents/skills/agent-runner/SKILL.md').read()
template = re.sub(r'## System Prompt Control\n.*?(?=## Rules)', '', template, flags=re.DOTALL)
template = template.replace('{{AGENT_NAME}}', '$agent')
template = template.replace('{{INVOCATION}}', '''$invocation''')
template = template.replace('{{PROMPT_PREFIX}}', '$prompt_prefix')
template = template.replace('{{SESSION_UUID}}', '$uuid')
print(template, end='')
")
    else
        rendered=$(python3 -c "
template = open('$HOME/.agents/skills/agent-runner/SKILL.md').read()
template = template.replace('{{AGENT_NAME}}', '$agent')
template = template.replace('{{INVOCATION}}', '''$invocation''')
template = template.replace('{{SYSTEM_PROMPT_FLAG}}', '$system_prompt_flag')
template = template.replace('{{PROMPT_PREFIX}}', '$prompt_prefix')
template = template.replace('{{SESSION_UUID}}', '$uuid')
print(template, end='')
")
    fi

    if $run_mode; then
        # --run: create temp file and pass to pi
        local tmp_file
        tmp_file=$(mktemp /tmp/skill-XXXXXX.md)
        echo "$rendered" > "$tmp_file"
        echo "🚀 Running agent $agent with task: $task"
        pi --skill "$tmp_file" -p "$task"
        rm -f "$tmp_file"

    elif $edit_mode; then
        # --edit: open in editor, then copy to clipboard
        local tmp_file
        tmp_file=$(mktemp /tmp/skill-XXXXXX.md)
        echo "$rendered" > "$tmp_file"
        local editor="${EDITOR:-nvim}"
        $editor "$tmp_file"
        _clip_copy < "$tmp_file"
        rm -f "$tmp_file"
        echo "✓ Rendered SKILL.md for $agent copied to clipboard"

    elif $dry_run_mode; then
        # --dry-run: show in terminal
        echo "$rendered"

    else
        # default: copy to clipboard
        if ! echo "$rendered" | _clip_copy; then
            echo "$rendered"
        fi
        echo "✓ Rendered SKILL.md for $agent copied to clipboard"
    fi
}

# Install APK on a selected device
# Usage: apk <path-to-apk>
apk() {
    local apk_file=${1:?"Usage: apk <path-to-apk>"}
    [ -f "$apk_file" ] || { echo "no file: $apk_file"; return 1; }

    local serial
    serial=$(adb devices | awk 'NR>1 && $2=="device" {print $1}' | fzf --height 20% --reverse --header "Устройство: ")
    [ -n "$serial" ] || return 1

    adb -s "$serial" install -r "$apk_file"
}
