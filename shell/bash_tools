# Bash tools - functions for bash shell

aigent() {
    local custom_system_prompt=""
    local task_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--system-prompt)
                if [ $# -lt 2 ]; then
                    echo "Error: $1 requires an argument"
                    return 1
                fi
                custom_system_prompt="$2"
                shift 2
                ;;
            *)
                task_args+=("$1")
                shift
                ;;
        esac
    done

    if [ ${#task_args[@]} -eq 0 ]; then
        echo "Usage: aigent [-s \"system prompt\"] \"task\""
        return 1
    fi

    unset LLM_BASE_URL LLM_API_KEY LLM_MODEL

    if [ -n "$custom_system_prompt" ]; then
        (cd ~/dotfiles/scripts && uv run ./aigent.py -s "$custom_system_prompt" "${task_args[@]}")
    else
        (cd ~/dotfiles/scripts && uv run ./aigent.py "${task_args[@]}")
    fi
}

krbot() {
    local custom_system_prompt=""
    local task_args=()

    # Parse flags: -s/--system-prompt takes one argument, everything else is task
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--system-prompt)
                if [ $# -lt 2 ]; then
                    echo "Error: $1 requires an argument"
                    return 1
                fi
                custom_system_prompt="$2"
                shift 2
                ;;
            *)
                task_args+=("$1")
                shift
                ;;
        esac
    done

    if [ ${#task_args[@]} -eq 0 ]; then
        echo "Usage: krbot [-s \"system prompt\"] \"task\""
        return 1
    fi

    local conf="$HOME/.config/dispatch/providers.conf"
    local script_dir="$HOME/dotfiles/scripts"
    if [ ! -f "$conf" ]; then
        echo "Error: $conf not found"
        return 1
    fi
    local url key model
    url=$(awk '/\[kr-jarvis\]/{f=1} f&&/^url=/{sub(/^url=/,""); print; exit}' "$conf")
    key=$(awk '/\[kr-jarvis\]/{f=1} f&&/^key=/{sub(/^key=/,""); print; exit}' "$conf")
    model=$(awk '/\[kr-jarvis\]/{f=1} f&&/^last_model=/{sub(/^last_model=/,""); sub(/\.gguf$/,"",$0); sub(/-Q[0-9]*_K.*/,""); print tolower($0); exit}' "$conf")
    if [ -z "$url" ] || [ -z "$key" ]; then
        echo "Error: url/key not found in $conf"
        return 1
    fi
    export LLM_BASE_URL="$url" LLM_API_KEY="$key" LLM_MODEL="$model"

    if [ -n "$custom_system_prompt" ]; then
        (cd "$script_dir" && uv run ./aigent.py -s "$custom_system_prompt" "${task_args[@]}")
    else
        (cd "$script_dir" && uv run ./aigent.py "${task_args[@]}")
    fi
}
