# Dump all files under a directory (default: current) to the clipboard,
# excluding junk dirs and masking sensitive values (keys, tokens, passwords, ...).
# Usage: dumpdir [dir]
unalias dumpdir 2>/dev/null   # allow reload: drop leftover alias from a previous session
dumpdir() {
    local src="${1:-.}" tmp
    tmp=$(mktemp "${TMPDIR:-/tmp}/dumpdir.XXXXXX")
    if python3 "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/dumpdir.py" "$src" > "$tmp"; then
        if _clip_copy < "$tmp"; then
            echo "✅ $(wc -l < "$tmp" | tr -d ' ') lines copied to clipboard (secrets masked)"
        else
            cat "$tmp"
        fi
    else
        echo "❌ dumpdir: failed" >&2
    fi
    rm -f "$tmp"
}

